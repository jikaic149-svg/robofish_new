{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug-local"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug-local"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug-local", "--target", "flash"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Debug",
      "problemMatcher": []
    },
    {
      "label": "OpenOCD Debug Server",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug-local", "--target", "debug-server"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Debug",
      "problemMatcher": []
    },
    {
      "label": "GDB Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug-local", "--target", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
