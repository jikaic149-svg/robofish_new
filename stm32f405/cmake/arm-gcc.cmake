set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m4)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GCC_BIN "$ENV{ARM_GCC_BIN}" CACHE PATH "Arm GNU toolchain bin directory")
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${ARM_GCC_BIN}" REQUIRED)
find_program(CMAKE_CXX_COMPILER arm-none-eabi-g++ HINTS "${ARM_GCC_BIN}" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(compiler_dir "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${compiler_dir}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${compiler_dir}" REQUIRED)
find_program(CMAKE_NM arm-none-eabi-nm HINTS "${compiler_dir}" REQUIRED)
find_program(ARM_GDB_EXECUTABLE arm-none-eabi-gdb HINTS "${compiler_dir}")
