+static int receive_timeout(struct cmsis_dap_backend_data *data)
+{
+	if (data->receive_count) {
+		/* Never reuse a timed-out partial frame for a later command. */
+		LOG_ERROR("CMSIS-DAP: timeout in partial TCP frame; reconnect required");
+		data->receive_failed = true;
+		return ERROR_FAIL;
+	}
+	return ERROR_TIMEOUT_REACHED;
+}
